{
  "info": {
    "name": "Backend Challenge",
    "description": "Login de integración, token de un solo uso y pagos idempotentes. Ejecuta los requests en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwt", "value": "" },
    { "key": "integrationToken", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login integration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.integrationToken) {",
                  "  pm.collectionVariables.set('integrationToken', body.integrationToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{jwt}}\"\n}" },
            "url": "{{baseUrl}}/auth/login-integration"
          }
        },
        {
          "name": "2. Redeem (primer uso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('redeemed = true', () => pm.expect(pm.response.json().redeemed).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{integrationToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/redeem"
          }
        },
        {
          "name": "3. Redeem (segundo uso → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{integrationToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/redeem"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "4. Crear pago (llave nueva)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('firstPayment', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10.5,\n  \"currency\": \"USD\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "5. Repetir pago (misma llave → mismo resultado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('mismo pago que el request 4', () => {",
                  "  const first = JSON.parse(pm.collectionVariables.get('firstPayment'));",
                  "  const replay = pm.response.json();",
                  "  pm.expect(replay.id).to.eql(first.id);",
                  "  pm.expect(replay.coreReference).to.eql(first.coreReference);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10.5,\n  \"currency\": \"USD\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "6. Misma llave, otro payload → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 99,\n  \"currency\": \"USD\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "7. Sin Idempotency-Key → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10.5,\n  \"currency\": \"USD\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "8. Body inválido → 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('invalidKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{invalidKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": -5,\n  \"currency\": \"usd\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        }
      ]
    }
  ]
}
